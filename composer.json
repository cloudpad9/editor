{
    "name": "cloudpad/cloudpad9",
    "description": "CloudPad9 — Web-based code editor",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CloudPad\\": "src/"
        },
        "files": [
            "src/Core/helpers.php",
            "src/I18n/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CloudPad\\Tests\\": "tests/"
        }
    }
}
